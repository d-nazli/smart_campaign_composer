# Copy to .env (`copy .env.example .env` on Windows). .env is git-ignored.
# docker compose works without a .env file too: every value below has a default.

# --- LLM ---------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run with the built-in mock LLM.
# Put a key here and restart to switch to real Claude with no code change.
ANTHROPIC_API_KEY=
# auto  = Claude if ANTHROPIC_API_KEY is set, otherwise mock LLM
# mock  = always mock (even when a key is present)
# claude = always Claude (fails at startup if the key is empty)
LLM_MODE=auto
CLAUDE_MODEL=claude-sonnet-5-5
# Mock LLM only: pause (ms) between streamed fragments, so the UI visibly streams.
MOCK_LLM_DELAY_MS=15

# --- Message limits ------------------------------------------------------------
# SMS <= 160 and email subject <= 80 characters are fixed by the case. Personalization
# variables are counted at a FIXED allowance, whatever the real value is:
# {{first_name}} counts as 20 characters, {{city}} as 15. If a person's real value is
# longer (or empty) the message uses a short fallback word instead, so the limit can
# never be exceeded. The allowances are also told to the model in its prompt.
# Raise them to allow longer names (this leaves less room for the text itself).
VARIABLE_BUDGET_FIRST_NAME=20
VARIABLE_BUDGET_CITY=15

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign

# --- Seed ----------------------------------------------------------------------
# Fixed RNG seed: the same fake users are generated on every fresh database.
# The seed runs only when the users table is empty. After changing these values
# (or the seed code) run `make clean` to drop the database volume.
SEED=42
SEED_USERS=5000

# --- Mock provider (chaos) -------------------------------------------------------
# The defaults below are deliberately noisy: about 11% of first attempts fail
# (5% 5xx, 3% injected 429, 1% timeout, 2% accepted-but-reported-as-failed) so
# retries, Retry-After handling and idempotency are visible in a demo.
#
# TO LOWER THE FAILURE RATE, set the *_RATE values closer to 0 (a rate is a
# probability between 0 and 1). For a clean, error-free run set them all to 0:
#   PROVIDER_ERROR_RATE=0  PROVIDER_429_RATE=0  PROVIDER_TIMEOUT_RATE=0
#   PROVIDER_FAIL_AFTER_ACCEPT_RATE=0
# then restart: docker compose up -d mock-provider
#
# Real per-channel rate limit (requests/second). Requests over the limit get a
# 429 with Retry-After, independent of the injected 429s below.
PROVIDER_RATE_LIMIT_PER_SEC=100
# Delay before answering = LATENCY_MS + a random 0..LATENCY_JITTER_MS.
PROVIDER_LATENCY_MS=50
PROVIDER_LATENCY_JITTER_MS=100
# Injected 500/502/503 before the message is accepted (nothing is delivered).
PROVIDER_ERROR_RATE=0.05
# Injected 429s (on top of the real limit); Retry-After is random in [MIN, MAX] seconds.
PROVIDER_429_RATE=0.03
PROVIDER_RETRY_AFTER_MIN_SEC=1
PROVIDER_RETRY_AFTER_MAX_SEC=3
# Answers with 504 only after TIMEOUT_MS (longer than the worker's client timeout).
PROVIDER_TIMEOUT_RATE=0.01
PROVIDER_TIMEOUT_MS=10000
# The message IS accepted and recorded, but the response is a 5xx. The worker
# retries with the same Idempotency-Key and must not cause a second delivery.
PROVIDER_FAIL_AFTER_ACCEPT_RATE=0.02
# Seed for the provider's random choices (same seed = same failure pattern).
PROVIDER_SEED=1

# --- Worker (sending) ------------------------------------------------------------
# Sends per second PER CHANNEL. Kept below the provider's real limit (100/s) on
# purpose: at exactly 100 the provider's sliding window would push back at the
# edges. Raise it only together with PROVIDER_RATE_LIMIT_PER_SEC.
WORKER_RATE_PER_SEC=90
# Parallel senders per channel (they share the one pace above).
WORKER_CONCURRENCY=64
# A delivery is failed after this many failed attempts (429s do not count).
WORKER_MAX_ATTEMPTS=5
# One provider call gives up after this long (must stay below PROVIDER_TIMEOUT_MS).
WORKER_REQUEST_TIMEOUT_MS=5000
