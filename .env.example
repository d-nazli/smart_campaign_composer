# Copy to .env (`copy .env.example .env` on Windows). .env is git-ignored.
# docker compose works without a .env file too: every value below has a default.

# --- LLM ---------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run with the built-in mock LLM.
# Put a key here and restart to switch to real Claude with no code change.
ANTHROPIC_API_KEY=
# auto  = Claude if ANTHROPIC_API_KEY is set, otherwise mock LLM
# mock  = always mock (even when a key is present)
# claude = always Claude (fails at startup if the key is empty)
LLM_MODE=auto
CLAUDE_MODEL=claude-sonnet-5-5

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign

# --- Seed ----------------------------------------------------------------------
# Fixed RNG seed: the same fake users are generated on every fresh database.
SEED=42
